package lucide

templ BuildingComplexPlus(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M10 12h4"></path>
		<path d="M10 21v-3a2 2 0 013.05-1.702"></path>
		<path d="M10 8h4"></path>
		<path d="M16 19h6"></path>
		<path d="M18 7h2a2 2 0 012 2v4.355"></path>
		<path d="M19 16v6"></path>
		<path d="M6 10H4a2 2 0 00-2 2v7a2 2 0 002 2h8.535"></path>
		<path d="M6 21V5a2 2 0 012-2h8a2 2 0 012 2v7.126"></path>
	</svg>
}
