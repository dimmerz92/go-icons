package lucide

templ FaceSlightlySmilingPlus(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M13.267 2.08a10 10 0 108.653 8.653"></path>
		<path d="M15 10V9"></path>
		<path d="M16 5h6"></path>
		<path d="M16.472 15a6 6 0 01-8.943 0"></path>
		<path d="M19 2v6"></path>
		<path d="M9 10V9"></path>
	</svg>
}
