package lucide

templ NotebookDot(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M16 11.75V22"></path>
		<path d="M2 10h4"></path>
		<path d="M2 14h4"></path>
		<path d="M2 18h4"></path>
		<path d="M2 6h4"></path>
		<path d="M20 11.75V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h5.65"></path>
		<circle cx="18" cy="5" r="3"></circle>
	</svg>
}
