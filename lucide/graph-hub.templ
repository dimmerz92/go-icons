package lucide

templ GraphHub(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<circle cx="12" cy="7" r="4"></circle>
		<circle cx="4" cy="19" r="2"></circle>
		<circle cx="12" cy="19" r="2"></circle>
		<circle cx="20" cy="19" r="2"></circle>
		<path d="M8 7a4 4 0 0 0-4 4v6"></path>
		<path d="M12 11v6"></path>
		<path d="M16 7a4 4 0 0 1 4 4v6"></path>
	</svg>
}
