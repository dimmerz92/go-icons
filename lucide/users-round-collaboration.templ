package lucide

templ UsersRoundCollaboration(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M20.453 8.911a9 9 0 00-6.696-5.738"></path>
		<path d="M21 22a4 4 0 00-8 0"></path>
		<path d="M3 12a4 4 0 017.963-.543"></path>
		<path d="M3.889 15.9a9 9 0 005.247 4.632"></path>
		<circle cx="17" cy="15" r="3"></circle>
		<circle cx="7" cy="5" r="3"></circle>
	</svg>
}
