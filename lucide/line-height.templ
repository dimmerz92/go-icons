package lucide

templ LineHeight(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M15 14H9"></path>
		<path d="M21 21H3"></path>
		<path d="M21 3H3"></path>
		<path d="m8 16 3.453-7.648a.6.6 0 011.094.001L16 16"></path>
	</svg>
}
