package lucide

templ RotateCwClock(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M12 7v5l4 2"></path>
		<path d="M16 8h5V3"></path>
		<path d="m21 8-2.3-2.3A9.7 9.7 0 0012 3a9 9 0 109 9"></path>
	</svg>
}
