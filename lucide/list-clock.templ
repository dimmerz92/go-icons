package lucide

templ ListClock(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M16 13v2.2l1.6 1"></path>
		<path d="M3 12h3.458"></path>
		<path d="M3 19h3.832"></path>
		<path d="M3 5h18"></path>
		<circle cx="16" cy="15" r="6"></circle>
	</svg>
}
