package lucide

templ MicAudioLines(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M10 3v2.341"></path>
		<path d="M12 17v4"></path>
		<path d="M14 5v.341"></path>
		<path d="M18 5v13"></path>
		<path d="M2 10v3"></path>
		<path d="M22 10v3"></path>
		<path d="M6 6v11"></path>
		<path d="M9 21h6"></path>
		<rect width="4" height="8" x="10" y="9" rx="2"></rect>
	</svg>
}
