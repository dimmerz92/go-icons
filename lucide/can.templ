package lucide

templ Can(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M21 10.5a9 2.5 0 01-18 0v8a9 2.5 0 0018 0z"></path>
		<path d="M21 10.5A9 2.5 25.32 004.59 3.47 9 2.5 25.32 0021 10.5"></path>
		<path d="M3 10.5a9 2.5 0 016.527-2.405"></path>
		<path d="M9 16.858a31 31 0 006 0"></path>
	</svg>
}
