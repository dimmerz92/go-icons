package lucide

templ EighthNote(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="m19 6-5.2-3.9a.5.5 0 0 0-.8.4V18"></path>
		<circle cx="9" cy="18" r="4"></circle>
	</svg>
}
