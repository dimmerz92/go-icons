package lucide

templ Tombstone(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M11 10h2"></path>
		<path d="M19 21V10a7 7 0 00-14 0v11"></path>
		<path d="M2 21h20"></path>
		<path d="M9 14h6"></path>
	</svg>
}
