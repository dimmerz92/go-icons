package lucide

templ AudioLinesOff(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M10 10v11"></path>
		<path d="M10 3v1.35"></path>
		<path d="M14 14v1"></path>
		<path d="M14 8v.35"></path>
		<path d="M18 5v7.35"></path>
		<path d="M2 10v3"></path>
		<path d="m2 2 20 20"></path>
		<path d="M22 10v3"></path>
		<path d="M6 6v11"></path>
	</svg>
}
