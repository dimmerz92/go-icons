package lucide

templ Bridge(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M10 9.728V16"></path>
		<path d="M14 9.728V16"></path>
		<path d="M18 20V4"></path>
		<path d="m22 11-4-4A7.5 7.5 0 0 1 6 7l-4 4"></path>
		<path d="M22 16H2"></path>
		<path d="M6 20V4"></path>
	</svg>
}
