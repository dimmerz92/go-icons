package lucide

templ CircleChevronsDown(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M9 14L12 17L15 14"></path>
		<path d="M9 8L12 11L15 8"></path>
		<circle cx="12" cy="12" r="10"></circle>
	</svg>
}
