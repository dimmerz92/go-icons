package lucide

templ TrashOff(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M10 11v6"></path>
		<path d="M14 17v-3"></path>
		<path d="M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-1.576.768"></path>
		<path d="M19 6v7.344"></path>
		<path d="m2 2 20 20"></path>
		<path d="M21 6h-9.344"></path>
		<path d="M3 6h3"></path>
		<path d="M5 6v14a2 2 0 002 2h10a2 2 0 002-2v-1"></path>
	</svg>
}
