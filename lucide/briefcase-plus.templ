package lucide

templ BriefcasePlus(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M13.354 20H4a2 2 0 01-2-2V8a2 2 0 012-2h16a2 2 0 012 2v3.354"></path>
		<path d="M16 11.354V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"></path>
		<path d="M16 17h6"></path>
		<path d="M19 14v6"></path>
	</svg>
}
