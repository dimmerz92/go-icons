package lucide

templ Trailer(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M10 11.341V10"></path>
		<path d="M14 13v-3"></path>
		<path d="M18 17V8a2 2 0 00-2-2H4a2 2 0 00-2 2v7a2 2 0 002 2h2"></path>
		<path d="M22 15v1a1 1 0 01-1 1H10"></path>
		<path d="M6 11.341V10"></path>
		<circle cx="8" cy="17" r="2"></circle>
	</svg>
}
