package tableroutline

// tags: [pile, elements, layout, stack, layers, cancel, remove, delete, close, reject]
// category: Design
// unicode: "102a1"
// version: "3.48"
templ StackX(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M12 4l-8 4l8 4l8 -4l-8 -4"></path>
		<path d="M4 12l8 4"></path>
		<path d="M4 16l8 4"></path>
		<path d="M22 22l-5 -5"></path>
		<path d="M17 22l5 -5"></path>
	</svg>
}
