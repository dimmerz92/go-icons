package tableroutline

// tags: [underscore, off, emphasis, horizontal, typography, underline, writing, font, character, word]
// category: Text
// unicode: "10269"
// version: "3.45"
templ UnderlineOff(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M7 7.4v2.6c0 2.8 2.2 5 5 5c.9 0 1.8 -.2 2.4 -.6"></path>
		<path d="M5 19h14"></path>
