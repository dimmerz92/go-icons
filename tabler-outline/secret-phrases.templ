package tableroutline

// tags: [seed, recovery, phrase, mnemonic, wallet, crypto, backup, password, security, words]
// category: System
// unicode: "10292"
// version: "3.47"
templ SecretPhrases(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M19 5h-14a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2 -2v-10a2 2 0 0 0 -2 -2"></path>
		<path d="M7 9h3"></path>
		<path d="M14 9h3"></path>
		<path d="M7 12h3"></path>
		<path d="M14 12h3"></path>
		<path d="M7 15h3"></path>
		<path d="M14 15h3"></path>
	</svg>
}
