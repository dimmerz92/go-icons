package tableroutline

// tags: [voice, assistant, ai, speech, sound, wave, audio, talk, siri, orb]
// category: Media
// unicode: "1028f"
// version: "3.47"
templ Voice(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
		<path d="M3 12c4 0 9.647 8.23 14.4 7.092"></path>
		<path d="M4.8 17.4c5.85 0 9.617 -7.2 15.3 -7.2"></path>
	</svg>
}
