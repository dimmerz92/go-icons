package tableroutline

// tags: [typography, off, font, typeface, emphasise, italic, writing, character, word]
// category: Text
// unicode: "10271"
// version: "3.45"
templ ItalicOff(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M11 5h6"></path>
		<path d="M7 19h6"></path>
		<path d="M11.8 12.9l-1.8 6.1"></path>
		<path d="M2.8 3l18 18"></path>
		<path d="M14 5l-1.2 4.1"></path>
	</svg>
}
