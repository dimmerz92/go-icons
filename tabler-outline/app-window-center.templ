package tableroutline

// tags: [browser, page, website, web, interface, app, window, application, software, layout, center, middle, position, align]
// category: System
// unicode: "10277"
// version: "3.45"
templ AppWindowCenter(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path>
		<path d="M11 11h2v2h-2v-2" fill="currentColor"></path>
	</svg>
}
