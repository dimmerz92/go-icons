package tableroutline

// tags: [pile, elements, layout, stack, layers, check, approve, verified, complete, success]
// category: Design
// unicode: "102a4"
// version: "3.48"
templ StackCheck(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M12 4l-8 4l8 4l8 -4l-8 -4"></path>
		<path d="M4 12l8 4"></path>
		<path d="M4 16l7.004 3.502"></path>
		<path d="M15 19l2 2l4 -4"></path>
	</svg>
}
