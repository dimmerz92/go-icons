package tableroutline

// tags: [twig, branch, stick, wood, tree, nature, forest, plant, organic, wilderness]
// category: Nature
// unicode: "1027e"
// version: "3.46"
templ Twig(attrs ...templ.Attributes) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if len(attrs) > 0 {
			{ attrs[0]... }
		}
	>
		<path d="M3 21l5 -4l3 -5l5 -2l5 -7"></path>
		<path d="M16 10h5"></path>
		<path d="M11 12v-8"></path>
		<path d="M8 17h7"></path>
	</svg>
}
